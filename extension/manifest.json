{
  "manifest_version": 3,
  "name": "Second Cursor",
  "version": "0.3.0",
  "description": "Lets the Second Cursor app drive its own background tabs without touching yours.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "debugger",
    "tabs",
    "tabGroups",
    "webNavigation",
    "nativeMessaging",
    "storage",
    "downloads",
    "history",
    "clipboardRead",
    "clipboardWrite",
    "identity",
    "identity.email"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
